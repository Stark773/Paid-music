{
    "name": "Muskan Music",
    "description": "A powerful Telegram Music Bot with multi-platform support via BabyAPI.",
    "logo": "https://telegra.ph/file/d30d11c4365c025c25e3e.jpg",
    "keywords": ["python3","telegram","bot","MusicBot","pyrogram","pytgcalls"],
    "env": {
      "API_ID": {"description": "Get from https://my.telegram.org", "value": "", "required": true},
      "API_HASH": {"description": "Get from https://my.telegram.org", "value": "", "required": true},
      "BOT_TOKEN": {"description": "Get from @BotFather", "value": "", "required": true},
      "MONGO_DB_URI": {"description": "MongoDB connection URI", "value": "", "required": true},
      "STRING_SESSION": {"description": "Pyrogram string session for assistant", "value": "", "required": true},
      "OWNER_ID": {"description": "Your Telegram user ID", "value": "", "required": true},
      "LOGGER_ID": {"description": "Log group/channel ID (with active voice chat)", "value": "", "required": true},
      "BASE_URL": {"description": "BabyAPI base URL", "value": "https://BabyAPI.Pro", "required": false},
      "API_KEY": {"description": "Your BabyAPI key from babyapi.pro", "value": "", "required": true},
      "SUPPORT_CHANNEL": {"description": "Your channel link", "value": "https://t.me/muskan_music_official", "required": false},
      "SUPPORT_CHAT": {"description": "Your support group link", "value": "https://t.me/muskan_music_support", "required": false},
      "HEROKU_APP_NAME": {"description": "Heroku app name for auto-restart", "value": "", "required": false},
      "HEROKU_API_KEY": {"description": "Heroku API key for auto-restart", "value": "", "required": false},
      "SPOTIFY_CLIENT_ID": {"description": "Spotify client ID (optional)", "value": "", "required": false},
      "SPOTIFY_CLIENT_SECRET": {"description": "Spotify client secret (optional)", "value": "", "required": false}
    },
    "buildpacks": [
      {"url": "heroku/python"}
    ]
}
